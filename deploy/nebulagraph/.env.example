# Optional overrides for compose.yaml.
TZ=Asia/Shanghai
NEBULA_GRAPH_PORT=9669
NEBULA_GRAPH_HTTP_PORT=19669

# Images are pinned to the server version expected by iGraph.
NEBULA_METAD_IMAGE=docker.io/vesoft/nebula-metad:v3.8.0
NEBULA_STORAGED_IMAGE=docker.io/vesoft/nebula-storaged:v3.8.0
NEBULA_GRAPHD_IMAGE=docker.io/vesoft/nebula-graphd:v3.8.0
NEBULA_CONSOLE_IMAGE=docker.io/vesoft/nebula-console:v3.6.0

# Source this file before starting iGraph if iGraph/.env has not been updated.
NEBULA_ENABLED=1
# Root Docker Compose: host.docker.internal:9669; native Graph Engine: 127.0.0.1:9669.
NEBULA_HOSTS=host.docker.internal:9669
NEBULA_USER=root
NEBULA_PASSWORD=nebula
NEBULA_SPACE=igraph
NEBULA_POOL_SIZE=10
NEBULA_BATCH_SIZE=256
NEBULA_SCHEMA_WAIT_SECONDS=30
NEBULA_MAX_RETRIES=3
