# Backend（前端唯一公共 API）
BACKEND_HOST=0.0.0.0
BACKEND_PORT=21109
# BACKEND_PROJECTS_FILE=data/backend/projects.json
AGENT_RUNTIME_URL=http://127.0.0.1:21112
GRAPH_ENGINE_URL=http://127.0.0.1:21111

# Agent Runtime / AgentOS
AGENT_RUNTIME_HOST=0.0.0.0
AGENT_RUNTIME_PORT=21112
AGENT_RUNTIME_DATABASE_URL=postgresql+psycopg://igraph:igraph@127.0.0.1:5432/igraph
GRAPH_ENGINE_MCP_URL=http://127.0.0.1:21110/mcp
# 分阶段启用：先部署并通过 docs/RUN_CANCELLATION.md 验收，再统一设为 true。
IGRAPH_RUN_CANCEL_ENABLED=false
# 完整部署必填：四个服务使用同一随机凭据，即使取消功能关闭也必须配置。
# 使用 python -c 'import secrets; print(secrets.token_hex(32))' 生成一次并填入下行。
# 启动时校验非空及无空白 ASCII 格式。请勿提交真实凭据。
IGRAPH_CONTROL_SERVICE_KEY=
BACKEND_CONTROL_URL=http://127.0.0.1:21109
GRAPH_ENGINE_API_URL=http://127.0.0.1:21111
AGENT_RUNTIME_AUTHORIZATION=false
AGENT_RUNTIME_TRACING=true
AGNO_TELEMETRY=false
EMBEDDING_MODEL=text-embedding-3-small
# 不配置下面两项时，AgentOS 仍启用 UserProfile/UserMemory/SessionContext/DecisionLog，
# 但不会启用依赖向量检索的 LearnedKnowledge。可兼容 OpenAI API 的 embedding 服务。
# EMBEDDING_API_KEY=...
# EMBEDDING_BASE_URL=...

# 可选：iGraph 本地数据/配置路径
# IGRAPH_DATA_ROOT=data
# IGRAPH_HOME=~/.igraph
# IGRAPH_MEMORY_ROOT=~/.igraph/memory
# IGRAPH_LOGS_DIR=logs
# IGRAPH_ADMIN_USER_ID=admin
# IGRAPH_DEFAULT_ADMIN_MODEL=claude-sonnet-4-6
# IGRAPH_DEFAULT_USER_MODEL=qwen3.6-plus

# 必填：各服务监听地址
MCP_HOST=0.0.0.0
MCP_PORT=21110
GRAPH_DATA_HOST=0.0.0.0
GRAPH_DATA_PORT=21111

# 必填：服务访问 URL（网关/MCP/脚本依赖）
MCP_SERVER_URL=http://127.0.0.1:21110/mcp
GRAPH_DATA_SERVER_URL=http://127.0.0.1:21111

# 可选：GraphData 服务侧上传文件落盘目录（远端部署建议配置持久目录）
# GRAPH_DATA_UPLOAD_DIR=uploads/graph_data

# 可选：统计可视化报告工具默认启用；设为 false/off/0 可关闭
# MCP_ENABLE_REPORTING_TOOLS=true

# 可选：本地 NebulaGraph 主存储（连接 Graph Service 端口，通常为 9669）
# 使用本地 Docker Compose 部署时，直接取消下面整个配置块的注释即可运行。
# GRAPH_STORAGE_BACKEND=nebula
# NEBULA_ENABLED=1
# NEBULA_HOSTS=127.0.0.1:9669
# NEBULA_USER=root
# NEBULA_PASSWORD=nebula
# NEBULA_SPACE=igraph
# NEBULA_POOL_SIZE=10
# NEBULA_BATCH_SIZE=256
# 大图导入：auto 在节点+边达到阈值时使用 Importer；小图继续用 Python 客户端
# NEBULA_IMPORT_METHOD=auto
# NEBULA_IMPORTER_THRESHOLD=100000
# NEBULA_IMPORTER_IMAGE=docker.io/vesoft/nebula-importer:v4
# NEBULA_IMPORTER_BINARY=
# NEBULA_IMPORTER_STAGING_DIR=data/nebula_importer
# NEBULA_IMPORTER_BATCH_SIZE=1000
# NEBULA_IMPORTER_READER_CONCURRENCY=4
# NEBULA_IMPORTER_CONCURRENCY=16
# NEBULA_IMPORTER_TIMEOUT_SECONDS=21600
# NEBULA_SCHEMA_WAIT_SECONDS=30
# NEBULA_MAX_RETRIES=3
# Nebula -> GraphData/NetworkX 有界物化上限
# NEBULA_MAX_MATERIALIZE_NODES=50000
# NEBULA_MAX_MATERIALIZE_EDGES=200000
# NEBULA_SEARCH_CANDIDATE_NODES=2000
# NEBULA_SEARCH_CANDIDATE_EDGES=10000

# 可选：图机器学习模型产物目录
# GRAPH_ML_ARTIFACT_ROOT=artifacts/graph_ml

# Memory、Learning、Session Context 和 Skills 由 AgentOS/Agno 管理。

# 可选：图计算进程池 worker 数（默认 min(4, cpu_count)）
# 每个 worker 是独立进程，有独立 GIL，可真正多核并行跑图算法
# GRAPH_COMPUTE_CONCURRENCY=4
# 可选：单轮 Agent 工具 DAG 最大并发数（1-32，默认4）
# AGENT_TOOL_MAX_CONCURRENCY=4
# 可选：普通图算法的全局/每用户并发（默认与计算 worker 数一致）
# GRAPH_COMPUTE_GLOBAL_CONCURRENCY=4
# GRAPH_COMPUTE_PER_USER_CONCURRENCY=4
# 可选：训练/推理等重任务每用户并发，默认1
# GRAPH_HEAVY_PER_USER_CONCURRENCY=1
# 可选：模型请求超时（秒）
LLM_TIMEOUT_SECONDS=180

# SQL/CSV 构图子代理：只在 Graph Engine 内部运行，不共享主 Agent 对话或工具。
# 默认使用 LLM；缺少凭据时明确构图失败。rules 仅用于显式离线基线/测试。
GRAPH_CONSTRUCTION_MODE=llm
GRAPH_CONSTRUCTION_QUERY_COUNT=15
GRAPH_CONSTRUCTION_MAX_ITERATIONS=6
GRAPH_CONSTRUCTION_MAX_TOOL_CALLS=24
GRAPH_CONSTRUCTION_BENCHMARK_REPEATS=3
GRAPH_CONSTRUCTION_MAX_SECONDS=900
# Per Graph Engine process. Full capacity rejects new builds immediately; each user can run one build.
GRAPH_CONSTRUCTION_CONCURRENCY=1
# 按领域复用此用户的构图经验；每次仍在当前数据上重新验收，不共享主 Agent 记忆。
GRAPH_CONSTRUCTION_EXPERIENCE_ENABLED=true
GRAPH_CONSTRUCTION_DOMAIN_CATEGORY=auto
# GRAPH_CONSTRUCTION_EXPERIENCE_TOP_K=8
# GRAPH_CONSTRUCTION_MODEL=qwen3.6-plus
# 可单独配置，也可复用下方对应供应商的 API_KEY/BASE_URL。
# GRAPH_CONSTRUCTION_API_KEY=...
# GRAPH_CONSTRUCTION_BASE_URL=...
# GRAPH_CONSTRUCTION_EXPECTED_QUERY_RUNS=100

# 可选：Docker Compose 统一前端入口（仅容器启动使用）
# FRONTEND_BIND_ADDRESS=0.0.0.0
# FRONTEND_PORT=21108

# 可选：允许登录的用户 ID 文件；相对路径按项目根目录解析
# IGRAPH_SUPPORTED_IDS_FILE=config/supported_ids.txt

# 任选其一配置模型供应商（以下仅示例）
# OPENAI_API_KEY=...
# OPENAI_BASE_URL=...
# CLAUDE_API_KEY=...
# CLAUDE_BASE_URL=...
# ANTHROPIC_API_KEY=...
# ANTHROPIC_BASE_URL=...
# QWEN_API_KEY=...
# QWEN_BASE_URL=...
# DEEPSEEK_API_KEY=...
# DEEPSEEK_BASE_URL=...
# ARK_API_KEY=...
# ARK_BASE_URL=...
# LLM_API_KEY=...
# LLM_BASE_URL=...
