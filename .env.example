# Backend（前端唯一公共 API）
BACKEND_HOST=0.0.0.0
BACKEND_PORT=21109
# BACKEND_PROJECTS_FILE=data/backend/projects.json
# 服务器预置图数据目录；Compose 使用容器内持久卷路径；直接本地运行可省略并使用 data/server_datasets
# BACKEND_SERVER_DATASETS_DIR=/data/server_datasets
# 未提供同名 .meta.json 时的图方向；单个数据集建议使用显式 sidecar 覆盖
# BACKEND_SERVER_DATASET_DEFAULT_DIRECTED=true
# BACKEND_SERVER_DATASETS_MAX_ENTRIES=10000
# 文本边表达到此大小后，在服务器数据源目录被发现时只预处理一次；设为 0 可对所有文本边表启用
# BACKEND_SERVER_DATASET_PREPROCESS_MIN_BYTES=67108864
# Backend 扫描新增服务器数据源的周期（秒）
# BACKEND_SERVER_DATASET_SCAN_SECONDS=30
# 长任务流的 SSE 心跳间隔；防止反向代理和浏览器连接在计算期间因空闲断开
# BACKEND_STREAM_HEARTBEAT_SECONDS=15
AGENT_RUNTIME_URL=http://127.0.0.1:21112
GRAPH_ENGINE_URL=http://127.0.0.1:21111
# Agent 对异步图任务的状态查询间隔；任务完成后会在同一轮对话直接返回最终结果
# AGENT_RUNTIME_JOB_POLL_INTERVAL_SECONDS=2
# 自动等待上限，0 表示不在 Agent 工具层设置上限（仍受上游 HTTP 流超时约束）
# AGENT_RUNTIME_JOB_WAIT_TIMEOUT_SECONDS=0

# Agent Runtime / AgentOS
AGENT_RUNTIME_HOST=0.0.0.0
AGENT_RUNTIME_PORT=21112
AGENT_RUNTIME_DATABASE_URL=postgresql+psycopg://igraph:igraph@127.0.0.1:5432/igraph
GRAPH_ENGINE_MCP_URL=http://127.0.0.1:21110/mcp
# 分阶段启用：先部署并通过 docs/RUN_CANCELLATION.md 验收，再统一设为 true。
IGRAPH_RUN_CANCEL_ENABLED=true
# 内置模型的上下文预算；需与部署网关实际支持的容量一致。
IGRAPH_MODEL_CONTEXT_WINDOW=131072
# 完整部署必填：四个服务使用同一随机凭据，即使取消功能关闭也必须配置。
# 使用 python -c 'import secrets; print(secrets.token_hex(32))' 生成一次并填入下行。
# 启动时校验非空及无空白 ASCII 格式。请勿提交真实凭据。
IGRAPH_CONTROL_SERVICE_KEY=
BACKEND_CONTROL_URL=http://127.0.0.1:21109
GRAPH_ENGINE_API_URL=http://127.0.0.1:21111
AGENT_RUNTIME_AUTHORIZATION=false
AGENT_RUNTIME_TRACING=true
AGNO_TELEMETRY=false
EMBEDDING_MODEL=text-embedding-3-small
# 不配置下面两项时，AgentOS 仍启用 UserProfile/UserMemory/SessionContext/DecisionLog，
# 但不会启用依赖向量检索的 LearnedKnowledge。可兼容 OpenAI API 的 embedding 服务。
# EMBEDDING_API_KEY=...
# EMBEDDING_BASE_URL=...

# 可选：iGraph 本地数据/配置路径
# IGRAPH_DATA_ROOT=data
# IGRAPH_HOME=~/.igraph
# IGRAPH_MEMORY_ROOT=~/.igraph/memory
# IGRAPH_LOGS_DIR=logs
# IGRAPH_ADMIN_USER_ID=admin
# IGRAPH_DEFAULT_ADMIN_MODEL=claude-sonnet-4-6
# IGRAPH_DEFAULT_USER_MODEL=qwen3.6-plus

# 必填：各服务监听地址
MCP_HOST=0.0.0.0
MCP_PORT=21110
GRAPH_DATA_HOST=0.0.0.0
GRAPH_DATA_PORT=21111

# 必填：服务访问 URL（网关/MCP/脚本依赖）
MCP_SERVER_URL=http://127.0.0.1:21110/mcp
GRAPH_DATA_SERVER_URL=http://127.0.0.1:21111

# 可选：GraphData 服务侧上传文件落盘目录（远端部署建议配置持久目录）
# GRAPH_DATA_UPLOAD_DIR=uploads/graph_data

# 可选：统计可视化报告工具默认启用；设为 false/off/0 可关闭
# MCP_ENABLE_REPORTING_TOOLS=true

# 可选：本地 NebulaGraph 主存储（连接 Graph Service 端口，通常为 9669）
# Graph Engine 由根目录 Docker Compose 启动时，通过宿主机访问单独部署的 NebulaGraph。
# 若 Graph Engine 直接运行在宿主机上，请改用 127.0.0.1:9669。
# GRAPH_STORAGE_BACKEND=nebula
# NEBULA_ENABLED=1
# NEBULA_HOSTS=host.docker.internal:9669
# NEBULA_USER=root
# NEBULA_PASSWORD=nebula
# NEBULA_SPACE=igraph
# NEBULA_POOL_SIZE=10
# NEBULA_BATCH_SIZE=256
# 大图导入：auto 在节点+边达到阈值时使用 Importer；小图继续用 Python 客户端
# NEBULA_IMPORT_METHOD=auto
# NEBULA_IMPORTER_THRESHOLD=100000
# NEBULA_IMPORTER_IMAGE=docker.io/vesoft/nebula-importer:v4
# NEBULA_IMPORTER_BINARY=
# NEBULA_IMPORTER_STAGING_DIR=data/nebula_importer
# NEBULA_IMPORTER_BATCH_SIZE=1000
# NEBULA_IMPORTER_READER_CONCURRENCY=4
# NEBULA_IMPORTER_CONCURRENCY=16
# NEBULA_IMPORTER_TIMEOUT_SECONDS=21600
# NEBULA_SCHEMA_WAIT_SECONDS=30
# NEBULA_MAX_RETRIES=3
# Nebula -> GraphData/NetworkX 有界物化上限
# NEBULA_MAX_MATERIALIZE_NODES=50000
# NEBULA_MAX_MATERIALIZE_EDGES=200000
# NEBULA_SEARCH_CANDIDATE_NODES=2000
# NEBULA_SEARCH_CANDIDATE_EDGES=10000

# 可选：图机器学习模型产物目录
# GRAPH_ML_ARTIFACT_ROOT=artifacts/graph_ml

# Memory、Learning、Session Context 和 Skills 由 AgentOS/Agno 管理。

# 可选：图计算进程池 worker 数（默认 min(4, cpu_count)）
# 每个 worker 是独立进程，有独立 GIL，可真正多核并行跑图算法
# GRAPH_COMPUTE_CONCURRENCY=4
# 可选：单轮 Agent 工具 DAG 最大并发数（1-3，默认3，配置更大值仍封顶3）
AGENT_TOOL_MAX_CONCURRENCY=3
# 可选：普通图算法的全局/每用户并发（默认与计算 worker 数一致）
# GRAPH_COMPUTE_GLOBAL_CONCURRENCY=4
# GRAPH_COMPUTE_PER_USER_CONCURRENCY=4
# 可选：训练/推理等重任务每用户并发，默认1
# GRAPH_HEAVY_PER_USER_CONCURRENCY=1

# 可选：超大图分区计算路径（持久作业默认串行，单个任务内部多进程并行）
# 达到任一阈值的全局算法禁止回退到 NetworkX；需先 prepare_large_graph 发布快照
# load_graph_from_upload 会流式计数边，并用固定 128 KiB 基数估算器探测离散节点，
# 即使紧凑文本低于字节阈值，只要达到点/边阈值也会直接进入大图准备路径。
# LARGE_GRAPH_NODE_THRESHOLD=1000000
# LARGE_GRAPH_EDGE_THRESHOLD=5000000
# 上传文件达到该大小时，在读取内容前直接路由到流式大图准备（默认 256 MiB）
# LARGE_GRAPH_UPLOAD_BYTES_THRESHOLD=268435456
# 大型 npz/pt/json 不能进入当前分区准备器；文件大小或 NPZ/PT 归档解压后大小
# 达到较低阈值时，提前拒绝在 API 中全量反序列化（默认 64 MiB）
# LARGE_GRAPH_BINARY_UPLOAD_BYTES_THRESHOLD=67108864
# 单个上传与每用户上传目录配额（默认 100 GiB / 200 GiB）
# LARGE_GRAPH_UPLOAD_MAX_BYTES=107374182400
# LARGE_GRAPH_USER_UPLOAD_QUOTA_BYTES=214748364800
# LARGE_GRAPH_PARTITIONS=16
# 为 API、NebulaGraph 和操作系统保留的可用内存比例
# LARGE_GRAPH_MEMORY_RESERVE_RATIO=0.25
# 始终保留的磁盘字节数（默认 2 GiB）
# LARGE_GRAPH_DISK_RESERVE_BYTES=2147483648
# 准备阶段临时 JSONL、排序 run、快照和 SQLite 索引的磁盘放大系数
# LARGE_GRAPH_PREPARATION_DISK_MULTIPLIER=12
# 派生小子图筛选集合的有界内存缓存；超过后自动回退 SQLite 查询。
# LARGE_GRAPH_DERIVED_SELECTION_CACHE_ROWS=100000
# 外部排序每批最大记录数；越大越快，但单个 reducer 占用更多内存
# LARGE_GRAPH_SORT_CHUNK_ROWS=200000
# 单批排序的编码数据预算，同时约束异常长记录下的内存（默认 128 MiB）
# LARGE_GRAPH_SORT_CHUNK_BYTES=134217728
# 单条边/三元组记录的最大字节数，超限按 invalid_records 策略处理
# LARGE_GRAPH_MAX_RECORD_BYTES=1048576
# 规范化节点标识/显示名的最大 UTF-8 字节数，防止控制面被单个标识撑大
# LARGE_GRAPH_MAX_NODE_ID_BYTES=4096
# 每个 map/shuffle 进程最多同时打开的分区输出文件数（内部限制为 4..128）
# LARGE_GRAPH_MAP_OPEN_FILES=64
# degree 快速路径每次写入分片临时 SQLite 的最大行数（内部限制为 128..65536）
# LARGE_GRAPH_REDUCE_BATCH_ROWS=4096
# 外部排序多级归并的最大输入路数，限制同时打开的 run 文件数量
# LARGE_GRAPH_MERGE_FAN_IN=64
# 子任务默认使用 spawn；替代启动方式仅支持 forkserver，大图 Worker 禁止 fork
# LARGE_GRAPH_MP_START_METHOD=spawn
# 单进程本地开发默认 true；Compose 已设为 false 并启动独立 graph-engine-worker
# LARGE_GRAPH_EMBEDDED_WORKER=true
# 子进程等待父 Worker 持久化 PID/启动时间身份的最长秒数；超时不得开始图 I/O
# LARGE_GRAPH_START_GATE_SECONDS=30
# 父 Worker 等待新子进程完成 setsid 并取得 Linux 启动身份的最长秒数
# LARGE_GRAPH_WORKER_IDENTITY_TIMEOUT_SECONDS=5
# 大图社区检测默认传播轮数；可在单机资源允许时由请求显式提高（硬上限 500）
# LARGE_GRAPH_COMMUNITY_DEFAULT_MAX_ITERATIONS=5
# 单个大图底层进程的 wall-time 硬上限（秒，从 Process.start 起算）；默认 24 小时，<=0 禁用
# LARGE_GRAPH_MAX_JOB_SECONDS=86400
# 删除会话时等待底层大图进程确认取消的最长秒数；超时会保留目录并要求重试
# LARGE_GRAPH_DELETE_WAIT_SECONDS=10
# 全图链路预测的安全节点上限；超过后要求 source/target 或显式 allow_expensive=true
# LARGE_GRAPH_LINK_PREDICTION_MAX_NODES=10000
# 简单环、最大环和团枚举的安全节点上限
# LARGE_GRAPH_ENUMERATION_MAX_NODES=50000
# 最大团大小/逐节点团计数必须穷举全部极大团，使用更保守的独立默认阈值
# LARGE_GRAPH_EXACT_CLIQUE_MAX_NODES=40
# Yen k-shortest 的入队前最坏节点引用下界；allow_expensive 可显式越过该默认阈值
# LARGE_GRAPH_YEN_MAX_PATH_STATE_NODES=1000000
# Yen Worker 实际 accepted/candidate 路径状态的硬字节上限（不受 allow_expensive 绕过）
# LARGE_GRAPH_YEN_MAX_PATH_STATE_BYTES=134217728
# 全局最小割重复流计算的安全节点上限
# LARGE_GRAPH_GLOBAL_CUT_MAX_NODES=100000
# 精确 closeness/harmonic、平均最短路、直径/半径的 V×E 工作量上限
# LARGE_GRAPH_REPEATED_TRAVERSAL_MAX_WORK=250000000
# betweenness/load/percolation 的 Brandes 默认源点上限；超过时标记为采样近似
# LARGE_GRAPH_BRANDES_SOURCES=256
# 单次 Brandes 抽样源点的部署硬上限；不可由 allow_expensive 绕过
# LARGE_GRAPH_MAX_SAMPLE_SOURCES=10000
# transitivity/average_clustering 的估算邻接楔枚举上限
# LARGE_GRAPH_TRIANGLE_MAX_WORK=500000000
# VoteRank 最坏需逐轮扫描全边，限制 V×E 工作量
# LARGE_GRAPH_VOTERANK_MAX_WORK=250000000
# 所有算法通用的最终估算工作量上限；0 表示禁用
# LARGE_GRAPH_MAX_ESTIMATED_WORK_UNITS=2000000000
# 大图算法控制面 JSON 与 node_subset 节点列表上限
# LARGE_GRAPH_MAX_PARAMETER_BYTES=65536
# LARGE_GRAPH_MAX_PARAMETER_NODES=10000
# 平面性、通用加权匹配和均衡着色的有界原生精确路径上限；超限模式使用外存近似或明确拒绝。
# LARGE_GRAPH_NATIVE_EXACT_NODE_LIMIT=50000
# LARGE_GRAPH_NATIVE_EXACT_EDGE_LIMIT=250000
# 小图控制面三元组数量与自然语言文本大小上限（默认 100 万条 / 16 MiB）
# GRAPH_SMALL_MAX_STRUCTURED_ROWS=1000000
# TEXT2GRAPH_MAX_INPUT_BYTES=16777216
# 可选：模型请求超时（秒）
LLM_TIMEOUT_SECONDS=180

# SQL/CSV 构图子代理：只在 Graph Engine 内部运行，不共享主 Agent 对话或工具。
# 默认使用 LLM；缺少凭据时明确构图失败。rules 仅用于显式离线基线/测试。
GRAPH_CONSTRUCTION_MODE=llm
GRAPH_CONSTRUCTION_QUERY_COUNT=15
GRAPH_CONSTRUCTION_MAX_ITERATIONS=6
GRAPH_CONSTRUCTION_MAX_TOOL_CALLS=24
GRAPH_CONSTRUCTION_BENCHMARK_REPEATS=3
GRAPH_CONSTRUCTION_MAX_SECONDS=900
# TXT 语义构图：支持 100 万字符；分块预算含重叠，调用预算含每块最多三次尝试。
# GRAPH_CONSTRUCTION_TEXT_MAX_CHARACTERS=1000000
# GRAPH_CONSTRUCTION_TEXT_MAX_CHUNKS=4096
# GRAPH_CONSTRUCTION_TEXT_MAX_CALLS=12288
# TXT 独立使用此超时（12 小时），不受上面的 SQL/CSV MAX_SECONDS 影响。
# 单次请求显式传入 options.max_seconds 时仍优先使用请求值。
# GRAPH_CONSTRUCTION_TEXT_MAX_SECONDS=43200
# Per Graph Engine process. Full capacity rejects new builds immediately; each user can run one build.
GRAPH_CONSTRUCTION_CONCURRENCY=1
# 按领域复用此用户的构图经验；每次仍在当前数据上重新验收，不共享主 Agent 记忆。
GRAPH_CONSTRUCTION_EXPERIENCE_ENABLED=true
GRAPH_CONSTRUCTION_DOMAIN_CATEGORY=auto
# GRAPH_CONSTRUCTION_EXPERIENCE_TOP_K=8
# GRAPH_CONSTRUCTION_MODEL=qwen3.6-plus
# 可单独配置，也可复用下方对应供应商的 API_KEY/BASE_URL。
# GRAPH_CONSTRUCTION_API_KEY=...
# GRAPH_CONSTRUCTION_BASE_URL=...
# GRAPH_CONSTRUCTION_EXPECTED_QUERY_RUNS=100

# 可选：Docker Compose 统一前端入口（仅容器启动使用）
# FRONTEND_BIND_ADDRESS=0.0.0.0
# FRONTEND_PORT=21108

# 可选：允许登录的用户 ID 文件；相对路径按项目根目录解析
# IGRAPH_SUPPORTED_IDS_FILE=config/supported_ids.txt

# 任选其一配置模型供应商（以下仅示例）
# OPENAI_API_KEY=...
# OPENAI_BASE_URL=...
# CLAUDE_API_KEY=...
# CLAUDE_BASE_URL=...
# ANTHROPIC_API_KEY=...
# ANTHROPIC_BASE_URL=...
# QWEN_API_KEY=...
# QWEN_BASE_URL=...
# DEEPSEEK_API_KEY=...
# DEEPSEEK_BASE_URL=...
# ARK_API_KEY=...
# ARK_BASE_URL=...
# LLM_API_KEY=...
# LLM_BASE_URL=...

# Workspace storage is shared by Backend and Runtime under IGRAPH_DATA_ROOT/workspaces.
# IGRAPH_WORKSPACE_ROOT=/data/workspaces
# Shell execution fails closed without a usable bubblewrap sandbox.
# IGRAPH_WORKSPACE_SANDBOX_MODE=auto
# 禁止 namespace 的 rootless 主机可禁用 shell 执行，继续使用图分析和聊天。
# IGRAPH_WORKSPACE_SANDBOX_MODE=disabled
# Explicit local development only, never for untrusted uploaded code:
# IGRAPH_WORKSPACE_SANDBOX_MODE=fallback
# IGRAPH_WORKSPACE_EXEC_TIMEOUT_SECONDS=30
# IGRAPH_WORKSPACE_OUTPUT_LIMIT=100000
# Workspace dependency install timeout (seconds). A first uv install of a large
# package such as torch can take minutes; a per-user cache hit takes seconds.
# IGRAPH_WORKSPACE_ENV_TIMEOUT_SECONDS=600
# Note: agent-runtime sets seccomp:unconfined in compose.yaml. bubblewrap cannot
# create namespaces under Docker's default seccomp profile, which forces the
# workspace into fallback mode with no filesystem isolation. The trade: the
# container loses one syscall-filtering layer, and the workspace gains real
# isolation. Uploaded code is confined by bubblewrap, so the exchange is worth it.
# IGRAPH_MAX_UPLOAD_BYTES=52428800
# Optional context compression/summary model work (disabled by default).
# IGRAPH_COMPRESS_TOOL_RESULTS=false
# IGRAPH_SESSION_SUMMARIES=false

# Structured request logs use the standard logging stream; optional rotating file directory.
# IGRAPH_RUNTIME_LOG_DIR=/data/logs
# IGRAPH_LOG_LEVEL=INFO
