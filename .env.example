# 必填：API Gateway
API_SERVER_HOST=0.0.0.0
API_SERVER_PORT=21109
API_UPLOAD_DIR=uploads

# 可选：iGraph 本地数据/配置路径
# IGRAPH_DATA_ROOT=data
# IGRAPH_HOME=~/.igraph
# IGRAPH_MEMORY_ROOT=~/.igraph/memory
# IGRAPH_LOGS_DIR=logs
# IGRAPH_ADMIN_USER_ID=admin
# IGRAPH_DEFAULT_ADMIN_MODEL=claude-sonnet-4-6
# IGRAPH_DEFAULT_USER_MODEL=qwen3.6-plus

# 必填：各服务监听地址
MCP_HOST=0.0.0.0
MCP_PORT=21110
GRAPH_DATA_HOST=0.0.0.0
GRAPH_DATA_PORT=1111

# 必填：服务访问 URL（网关/MCP/脚本依赖）
MCP_SERVER_URL=http://127.0.0.1:21110/mcp
GRAPH_DATA_SERVER_URL=http://127.0.0.1:21111

# 可选：GraphData 服务侧上传文件落盘目录（远端部署建议配置持久目录）
# GRAPH_DATA_UPLOAD_DIR=uploads/graph_data

# 可选：NebulaGraph 混合存储（默认关闭；连接 Graph Service 端口，通常为 9669）
# NEBULA_ENABLED=0
# NEBULA_HOSTS=127.0.0.1:9669
# NEBULA_USER=root
# NEBULA_PASSWORD=nebula
# NEBULA_SPACE=igraph
# NEBULA_POOL_SIZE=10
# NEBULA_BATCH_SIZE=256
# NEBULA_SCHEMA_WAIT_SECONDS=30
# NEBULA_MAX_RETRIES=3

# 可选：图机器学习模型产物目录
# GRAPH_ML_ARTIFACT_ROOT=artifacts/graph_ml

# 可选：协议模式（text=文本协议默认，native=原生 Function Calling）
# text 模式上下文完全透明，适合 SFT/RL 数据采集；native 模式工具调用更可靠但上下文不透明
LLM_TOOL_PROTOCOL=text

# 可选：模型请求超时（秒）
LLM_TIMEOUT_SECONDS=180

# 任选其一配置模型供应商（以下仅示例）
# OPENAI_API_KEY=...
# OPENAI_BASE_URL=...
# CLAUDE_API_KEY=...
# CLAUDE_BASE_URL=...
# QWEN_API_KEY=...
# QWEN_BASE_URL=...
# DEEPSEEK_API_KEY=...
# DEEPSEEK_BASE_URL=...
# LLM_API_KEY=...
# LLM_BASE_URL=...
