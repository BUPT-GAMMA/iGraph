[run]
branch = True
source =
    agent_runtime
    backend
    graph_data_service
    graph_engine
    mcp_service

[report]
# Aggregate coverage is informational. CI enforces separate line/branch floors
# through scripts/check_coverage.py; see docs/CI_QUALITY_POLICY.md.
fail_under = 0
precision = 2
show_missing = True
skip_empty = True
