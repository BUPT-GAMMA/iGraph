server {
    listen 80;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    client_max_body_size 512m;

    # Construction graph responses are large, repetitive JSON documents. Keep
    # streaming endpoints untouched while compressing ordinary API payloads.
    gzip on;
    gzip_comp_level 5;
    gzip_min_length 1024;
    gzip_proxied any;
    gzip_vary on;
    gzip_types application/json;

    location = /health {
        access_log off;
        default_type application/json;
        return 200 '{"status":"ok","service":"frontend"}';
    }

    location /api/ {
        proxy_pass http://${BACKEND_HOST}:${BACKEND_PORT};
        proxy_http_version 1.1;
        proxy_buffering off;
        proxy_request_buffering off;
        proxy_cache off;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
    }

    # Backend 是前端唯一公共 API 入口。
    location = /openapi.json {
        proxy_pass http://${BACKEND_HOST}:${BACKEND_PORT};
    }

    location = /docs {
        proxy_pass http://${BACKEND_HOST}:${BACKEND_PORT};
    }

    location = /redoc {
        proxy_pass http://${BACKEND_HOST}:${BACKEND_PORT};
    }

    location = /favicon.ico {
        alias /usr/share/nginx/html/figures/igraph_light.png;
    }

    # Serve bundled walkthroughs directly, including byte-range requests for seeking.
    location /media/user-cases/ {
        try_files $uri =404;
        add_header X-Content-Type-Options nosniff;
    }

    location / {
        try_files $uri $uri/ /index.html;
    }
}
